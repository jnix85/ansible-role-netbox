# Managed by Ansible
server {
    listen 443 ssl;
    server_name {{ netbox_public_fqdn }} {{ vm_fqdn }} {{ vips.netbox }} {{ ansible_host | default(vm_ip | default('')) }};

    ssl_certificate     {{ acme_cert_fullchain_file }};
    ssl_certificate_key {{ acme_cert_key_file }};

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# Plain HTTP also proxies (Proxmox SDN IPAM can use http://VIP/api without a
# name that resolves before the DNS cluster exists).
server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
